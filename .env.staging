# Staging – set to your staging API URL when deploying
VITE_API_BASE=https://dzsm2dbswvuqy.cloudfront.net
VITE_GRAPHQL_BASE=https://dzsm2dbswvuqy.cloudfront.net
VITE_GRAPHQL_ENDPOINT=/graphql

NODE_ENV=staging
NPM_FLAGS=--legacy-peer-deps


# Cloudflare Turnstile site key (public). Enables the widget on Login and Register.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxp3PNOvS-yhlun

# Indexed, because vedic-astrology.app serves this build. 0 would make every page noindex.
VITE_SEO_INDEX=1
# Absolute og:url and og:image in the prerendered pages. Amplify env vars do not reach this build: it runs in GitHub Actions.
VITE_SITE_URL=https://vedic-astrology.app
# The life reading tab on the profile. The API needs TIMELINE_ENABLED=1 too.
VITE_TIMELINE_ENABLED=true
# How long each home page sky scene stays, in seconds (default 120). A change needs a new build.
VITE_SKY_HOLD_SECONDS=120
