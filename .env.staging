# Staging – set to your staging API URL when deploying
VITE_API_BASE=https://aiastraserver.onrender.com
VITE_GRAPHQL_BASE=https://aiastraserver.onrender.com
VITE_GRAPHQL_ENDPOINT=/graphql

NODE_ENV=staging
NPM_FLAGS=--legacy-peer-deps


# Cloudflare Turnstile site key (public). Enables the widget on Login and Register.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACxp3PNOvS-yhlun
