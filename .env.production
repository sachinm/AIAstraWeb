# Production – for same-origin (e.g. Vercel) use /api/graphql; for separate API host use full URL
VITE_API_BASE=https://aiastraserver.onrender.com
VITE_GRAPHQL_BASE=https://aiastraserver.onrender.com
VITE_GRAPHQL_ENDPOINT=/graphql

NODE_ENV=production
NPM_FLAGS=--legacy-peer-deps

# SEO: public pages are indexed. Set the live domain so canonical links, Open Graph URLs and sitemap.xml are absolute.
VITE_SEO_INDEX=1
# VITE_SITE_URL=https://www.example.com
# How long each home page sky scene stays, in seconds (default 120). A change needs a new build.
VITE_SKY_HOLD_SECONDS=120
