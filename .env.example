# GraphQL API – per environment (Vite loads .env.development / .env.staging / .env.production by mode)
# Development: http://localhost:3000/graphql
# Staging/Production: set to your deployed API URL
VITE_GRAPHQL_ENDPOINT=http://localhost:3000/graphql

# Cloudflare Turnstile (public site key). Required when the API has TURNSTILE_SECRET_KEY set.
# VITE_TURNSTILE_SITE_KEY=

# Optional: browser timeout for chat `ask` (ms). Default 900000 (15 min). Min 60000 if set, or 0 = no client timeout.
# VITE_GRAPHQL_ASK_TIMEOUT_MS=0

# Idle session: sign out after this many ms without user activity. Default 600000 (10 min).
# VITE_SESSION_IDLE_MS=600000

# Chat UI: SSE token streaming (POST /api/chat/ask-stream) is the DEFAULT when this variable is omitted or empty.
# Set to 0, false, or off to use GraphQL `ask` only (no streaming).
# VITE_CHAT_STREAM=0

# Shown on the legal pages and footers; unset shows no address and "the operator of AdAstra AI".
# VITE_LEGAL_ENTITY=
# VITE_SUPPORT_EMAIL=

# SEO. The absolute public site URL (no trailing slash) drives canonical links, Open Graph URLs and sitemap.xml; without
# it the sitemap is not emitted and canonicals use the page origin. VITE_SEO_INDEX=0 makes a build noindex everywhere
# (staging, previews). Local and *.amplifyapp.com hosts are never indexed regardless.
# VITE_SITE_URL=https://www.example.com
# VITE_SEO_INDEX=1
# How long each home page sky scene stays, in seconds (default 120, minimum 10). A change needs a new build.
# VITE_SKY_HOLD_SECONDS=120
